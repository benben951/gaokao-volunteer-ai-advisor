PORT=8787

# Optional: PostgreSQL / Supabase / CloudBase database URL.
DATABASE_URL=postgres://user:password@localhost:5432/gaokao_demo

# Optional: LLM gateway key. Never commit real keys.
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional access gate for private deployments.
ACCESS_CODE=demo-code
SESSION_SECRET=replace-with-random-secret
